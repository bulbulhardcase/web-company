# Server-side only — never commit real keys. Copy to `.env` locally.
# `npm run dev` loads `.env` via dotenv (see server/index.ts).

OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# Optional override (default: openrouter/free — Free Models Router)
# Docs: https://openrouter.ai/docs/guides/routing/routers/free-router
OPENROUTER_MODEL=openrouter/free

PORT=3333
NODE_ENV=development

# CORS: comma-separated origins, or * for any (dev only)
CORS_ORIGIN=*

# Set to 1 when behind a reverse proxy (rate limit uses correct client IP)
TRUST_PROXY=0

# Chat API rate limit (per IP)
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=30

# Session store (in-memory): max rows + TTL
CHAT_MAX_SESSIONS=500
CHAT_SESSION_TTL_MS=86400000

# Max user message length (characters)
CHAT_MAX_MESSAGE_CHARS=8000
