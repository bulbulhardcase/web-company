# Server-side only — never commit real keys. Copy to `.env.local` locally.
# `npm run dev` loads `.env.local`, then `.env` (see server/env.ts).

# Support chat runs on Ollama Cloud. Key: https://ollama.com/settings/keys
OLLAMA_API_KEY=your-ollama-api-key
# Optional override (default: gpt-oss:20b). List: curl https://ollama.com/api/tags
OLLAMA_MODEL=gpt-oss:20b

API_PORT=3333

# CORS: comma-separated origins, or * for any (dev only)
CORS_ORIGIN=*

# Set to 1 when behind a reverse proxy (rate limit uses correct client IP)
TRUST_PROXY=0

# Chat API rate limit (per IP) — local dev server only; in production use a Vercel Firewall rate-limit rule
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=30

