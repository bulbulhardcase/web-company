{
  "name": "bulbul-hardcase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,api -c blue,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:vite": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@openrouter/sdk": "^0.11.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "eventemitter3": "^5.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.4"
  }
}
